{
  "name": "sherpy-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "services": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "services:restart": "docker compose restart",
    "langfuse": "docker compose up -d langfuse",
    "langfuse:logs": "docker compose logs -f langfuse",
    "langfuse:reset": "docker compose down -v && docker compose up -d langfuse",
    "prepare": "husky",
    "seed": "node scripts/seed-project.js",
    "seed:step1": "node scripts/seed-project.js 1",
    "seed:step2": "node scripts/seed-project.js 2",
    "seed:step3": "node scripts/seed-project.js 3",
    "seed:step5": "node scripts/seed-project.js 5",
    "seed:step10": "node scripts/seed-project.js 10",
    "snapshots:generate": "tsx scripts/generate-snapshots.ts",
    "snapshots:generate-edge-cases": "tsx scripts/generate-edge-case-snapshots.ts",
    "snapshots:validate": "tsx scripts/validate-snapshots.ts",
    "snapshots:list": "tsx scripts/validate-snapshots.ts --list",
    "snapshots:stats": "tsx scripts/validate-snapshots.ts --stats"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1044.0",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/bodoni-moda": "^5.2.7",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-start": "^1.167.64",
    "@tanstack/start-plugin-core": "^1.169.19",
    "@xstate/react": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langfuse": "^3.30.3",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.31.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.4.14",
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.3.6",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.4",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vinxi": "^0.5.11",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
