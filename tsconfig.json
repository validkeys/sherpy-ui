{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["app", "src", "vitest.shims.d.ts"],
  "exclude": [
    "_ref",
    "node_modules",
    "scripts",
    "src/**/*.test.*",
    "src/**/*.stories.*",
    "src/**/*.skip.*"
  ]
}
