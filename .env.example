# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# App
PORT=3000
SEED_DATA=true

# Langfuse - LLM Observability (optional)
# Get keys from http://localhost:3100 after running `npm run langfuse`
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=http://localhost:3120
LANGFUSE_ENABLED=true


USE_MOCK_STREAMING=false

# Structured Output Feature Flag (gradual rollout)
# Enable JSON Schema-based structured responses from LLM
USE_STRUCTURED_OUTPUT=false
# Comma-separated list of step numbers to enable (default: 1)
STRUCTURED_OUTPUT_STEPS=1
