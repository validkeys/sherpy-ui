# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional when using AWS profiles or SSO locally.
# Run `aws sso login --profile your-profile` before live provider checks.
# Required permissions: bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream.
# AWS_PROFILE=your-profile

# App
PORT=3000
SEED_DATA=true

# Database
# Path to SQLite database file. Defaults to ~/.local/share/sherpy/sherpy.db
# Use :memory: for in-memory database (testing only)
SHERPY_DB_PATH=~/.local/share/sherpy/sherpy.db

# Testing & Development
# Enable test data seeding and snapshot capture APIs (required in development)
ALLOW_TEST_DATA=true

# Langfuse - LLM Observability (optional)
# Get keys from http://localhost:3100 after running `npm run langfuse`
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASEURL=http://localhost:3120
LANGFUSE_ENABLED=true


USE_MOCK_STREAMING=false
# Local/CI UI validation only. Generates deterministic artifacts without Bedrock.
# Never enable in production; server code rejects USE_MOCK_ARTIFACTS=true with NODE_ENV=production.
USE_MOCK_ARTIFACTS=false

# Structured Output Feature Flag (gradual rollout)
# Enable JSON Schema-based structured responses from LLM
USE_STRUCTURED_OUTPUT=false
# Comma-separated list of step numbers to enable (default: 1)
STRUCTURED_OUTPUT_STEPS=1
