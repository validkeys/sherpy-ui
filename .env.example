# ============================================================================
# AI Provider Configuration
# ============================================================================
# Choose ONE provider: bedrock | openai | anthropic
# See: docs/architecture/ai-providers.md for detailed setup
AI_PROVIDER=bedrock

# Optional: Override default model for selected provider
# If omitted, uses provider defaults (see below)
# AI_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ----------------------------------------------------------------------------
# AWS Bedrock (when AI_PROVIDER=bedrock) - PRIMARY PROVIDER
# ----------------------------------------------------------------------------
# REQUIRED: AWS region where Bedrock is enabled
# Supported: ca-central-1, us-east-1, us-west-2, eu-central-1, ap-northeast-1
AWS_REGION=ca-central-1

# REQUIRED: Bedrock model ID
# IMPORTANT: Model ID prefix must match region:
#   - US regions (us-east-1, us-west-2): us.anthropic.claude-sonnet-...
#   - Canada (ca-central-1): amer.anthropic.claude-sonnet-...
#   - Europe (eu-central-1): eu.anthropic.claude-sonnet-...
#   - Asia Pacific (ap-northeast-1): apac.anthropic.claude-sonnet-...
BEDROCK_MODEL_ID=amer.anthropic.claude-sonnet-4-5-20250929-v1:0

# OPTIONAL: AWS authentication method (choose ONE)
# Method 1: AWS SSO Profile (recommended for development)
# AWS_PROFILE=your-sso-profile
# Run first: aws sso login --profile your-sso-profile
#
# Method 2: AWS Access Keys (for CI/CD or non-SSO environments)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
#
# Required IAM permissions:
#   - bedrock:InvokeModel
#   - bedrock:InvokeModelWithResponseStream
#
# Verify setup: pnpm check:provider
# Troubleshooting: See .tmp-docs/AWS-BEDROCK-TROUBLESHOOTING.md

# ----------------------------------------------------------------------------
# OpenAI (when AI_PROVIDER=openai)
# ----------------------------------------------------------------------------
# REQUIRED: OpenAI API key
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# OPTIONAL: Custom base URL for OpenAI-compatible providers
# Examples: GLM, vLLM, LM Studio, local models
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1

# Default model: gpt-4o

# ----------------------------------------------------------------------------
# Anthropic Direct API (when AI_PROVIDER=anthropic)
# ----------------------------------------------------------------------------
# REQUIRED: Anthropic API key
# Get from: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Default model: claude-3-5-sonnet-20241022

# Benefits over Bedrock:
#   - Faster (no AWS middleware)
#   - Simpler auth (just API key)
#   - Latest models immediately
# Tradeoffs:
#   - No AWS cost tracking
#   - Direct billing to Anthropic account

# ============================================================================
# Application Configuration
# ============================================================================
# HTTP port for dev server
PORT=3000

# Seed database with test data on startup (development only)
SEED_DATA=true

# ============================================================================
# Database Configuration
# ============================================================================
# Path to SQLite database file
# Default: ~/.local/share/sherpy/sherpy.db
# Special value: :memory: (in-memory database, testing only)
SHERPY_DB_PATH=~/.local/share/sherpy/sherpy.db

# Note: better-sqlite3 is synchronous (not production-ready for multi-user)
# Hardening: Migrate to async DB (Turso, PostgreSQL)

# ============================================================================
# Testing & Development
# ============================================================================
# Enable test data seeding and snapshot capture APIs
# REQUIRED in development, DISABLED in production
ALLOW_TEST_DATA=true

# Use mock AI responses (no API calls, fast testing)
# Useful for: CI/CD, local testing without provider credentials
# Generated responses: Deterministic, no randomness
USE_MOCK_STREAMING=false

# Use mock artifacts (no AI generation, instant results)
# NEVER enable in production - server rejects in NODE_ENV=production
USE_MOCK_ARTIFACTS=false

# ============================================================================
# Langfuse - LLM Observability (Optional)
# ============================================================================
# Enable LLM tracing, token usage tracking, cost analysis
# Requires: Langfuse instance running (pnpm langfuse)
LANGFUSE_ENABLED=false

# Get keys from: http://localhost:3120 (after starting Langfuse)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASEURL=http://localhost:3120

# Features when enabled:
#   - Token usage per request
#   - Cost tracking per provider
#   - Latency analysis
#   - Error rate monitoring
#   - Prompt/response history
# See: docs/architecture/ai-providers.md#observability

# ============================================================================
# Structured Output (Feature Flag)
# ============================================================================
# Enable JSON Schema validation for AI responses
# When enabled: AI returns JSON objects (validated at tool-call layer)
# When disabled: AI returns text (parsed manually)
# USE_STRUCTURED_OUTPUT=false
# STRUCTURED_OUTPUT_STEPS=1,2,3  # Comma-separated step numbers

# ============================================================================
# Environment-Specific Notes
# ============================================================================
# DEVELOPMENT:
#   - Use AWS SSO profile or API keys
#   - Enable ALLOW_TEST_DATA, SEED_DATA
#   - Optional: USE_MOCK_STREAMING for fast iteration
#   - Optional: LANGFUSE_ENABLED for observability
#
# CI/CD:
#   - Use AWS access keys (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
#   - Enable USE_MOCK_STREAMING (no API calls)
#   - Disable LANGFUSE_ENABLED
#   - SHERPY_DB_PATH=:memory: (ephemeral database)
#
# PRODUCTION:
#   - Use AWS IAM role or access keys
#   - Disable ALLOW_TEST_DATA, USE_MOCK_STREAMING, USE_MOCK_ARTIFACTS
#   - SHERPY_DB_PATH points to persistent volume
#   - Enable LANGFUSE_ENABLED (self-hosted instance)
#
# See: docs/architecture/OVERVIEW.md#deployment
